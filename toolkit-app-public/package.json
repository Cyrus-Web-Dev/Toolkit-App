{
  "name": "toolkit-app-public",
  "version": "1.0.0",
  "description": "Toolkit produktivitas lokal: PDF, gambar, OCR, QR, dan AI Gemini. Edisi publik tanpa scraper/downloader media web.",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "server": "node server/index.js",
    "dev": "nodemon server/index.js",
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:win:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.4",
    "tesseract.js": "^5.1.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.0"
  },
  "build": {
    "appId": "com.local.toolkit-app",
    "productName": "Toolkit App",
    "copyright": "Copyright \u00a9 2026",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server/**/*",
      "public/**/*",
      "data/**/*",
      "package.json"
    ],
    "extraResources": [],
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@imgly/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "npmRebuild": true,
    "win": {
      "icon": "public/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Toolkit App",
      "installerIcon": "public/assets/icon.ico",
      "uninstallerIcon": "public/assets/icon.ico"
    }
  }
}
